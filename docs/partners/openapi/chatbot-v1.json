        "description": "GET /v1/sessions/{session_id} \u2014 check if a session is alive.\n\nReturns session metadata (category, turn count, whether a summary exists).\nReturns 404 if the session has expired or never existed.",
        "operationId": "v1_get_session_v1_sessions__session_id__get",
        "parameters": [
