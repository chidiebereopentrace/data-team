          }
        },
        "summary": "V1 Create Plan Session"
      }
    },
    "/v1/sessions/{session_id}": {
      "delete": {
        "description": "DELETE /v1/sessions/{session_id} \u2014 explicitly clear a session (logout / clear chat).\n\nIdempotent: returns success even if the session was already gone.",
        "operationId": "v1_delete_session_v1_sessions__session_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
