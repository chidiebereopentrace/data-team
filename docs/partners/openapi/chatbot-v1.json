{
  "components": {
    "schemas": {
      "ACFSignal": {
        "description": "Confidence signal attached to every RAG response (Path B).",
        "properties": {
          "applied_ceiling": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ceiling safeguard applied, if any.",
            "title": "Applied Ceiling"
          },
          "band": {
            "description": "Confidence band from open-trace ACF: very_strong, strong, moderate, limited, low, or no_evidence.",
            "enum": [
              "very_strong",
              "strong",
              "moderate",
              "limited",
              "low",
              "no_evidence"
            ],
            "title": "Band",
            "type": "string"
          },
          "band_label": {
            "description": "Human-readable band label (e.g. 'Strong confidence').",
            "title": "Band Label",
            "type": "string"
          },
          "claim_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Claim Level"
          },
          "components": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional T/A/F/G component breakdown.",
            "title": "Components"
          },
          "config_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ACF config version used for scoring.",
            "title": "Config Version"
          },
          "explanation": {
            "description": "One-sentence rationale for the score.",
            "title": "Explanation",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Alias of explanation (backward compatible).",
            "title": "Note"
          },
          "question_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question Type"
          },
          "score": {
            "description": "Composite confidence score (0\u2013100).",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "integer"
          }
        },
        "required": [
          "band",
          "band_label",
          "score",
          "explanation"
        ],
        "title": "ACFSignal",
        "type": "object"
      },
      "ArtifactItem": {
        "description": "Downloadable export produced on Agribusinesses / Integrated chat routes.",
        "properties": {
          "byte_size": {
            "description": "Artifact size in bytes",
            "minimum": 0.0,
            "title": "Byte Size",
            "type": "integer"
          },
          "citation_ids": {
            "description": "Citation ids from the parent answer that underpin this export",
            "items": {
              "type": "integer"
            },
            "title": "Citation Ids",
            "type": "array"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "description": "Stable artifact id for this response",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "description": "Export format",
            "enum": [
              "csv",
              "chart",
              "docx",
              "pdf",
              "html"
            ],
            "title": "Kind",
            "type": "string"
          },
          "mime_type": {
            "title": "Mime Type",
            "type": "string"
          },
          "summary": {
            "description": "Short description of the artifact contents",
            "title": "Summary",
            "type": "string"
          },
          "url": {
            "description": "Signed HTTPS URL (GCS) or local file URI in dev",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "filename",
          "mime_type",
          "url",
          "summary",
          "byte_size"
        ],
        "title": "ArtifactItem",
        "type": "object"
      },
      "ArtifactUrlResponse": {
        "properties": {
          "expires_in_seconds": {
            "title": "Expires In Seconds",
            "type": "integer"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "storage_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Storage Uri"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "filename",
          "url",
          "expires_in_seconds"
        ],
        "title": "ArtifactUrlResponse",
        "type": "object"
      },
      "ChatMessage": {
        "properties": {
          "content": {
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "description": "user or assistant",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage",
        "type": "object"
      },
      "CitationItem": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "id",
          "kind",
          "text"
        ],
        "title": "CitationItem",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "QueryRequest": {
        "additionalProperties": false,
        "properties": {
          "academic_top_k": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Academic Top K"
          },
          "bq_top_k": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bq Top K"
          },
          "chat_history": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ChatMessage"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Prior turns for this request (canonical). Server session is not updated when set.",
            "title": "Chat History"
          },
          "conversation_history": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ChatMessage"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Deprecated alias for chat_history.",
            "title": "Conversation History"
          },
          "include_trace": {
            "default": false,
            "description": "Include sanitized SQL, decomposition, retrieval diagnostics, and stage timings in response",
            "title": "Include Trace",
            "type": "boolean"
          },
          "news_top_k": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "News Top K"
          },
          "ota_top_k": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ota Top K"
          },
          "query": {
            "description": "Natural language question for the RAG",
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "rerank_top_k": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rerank Top K"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Omit to start a new session; reuse for multi-turn chat (server-side memory)",
            "title": "Session Id"
          },
          "time_end_override": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time End Override"
          },
          "time_start_override": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time Start Override"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional product user id for Langfuse user analytics (client-supplied until auth).",
            "title": "User Id"
          },
          "user_profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserProfile"
              },
              {
                "type": "null"
              }
            ],
            "description": "User profile: country, plan_type (access/geo), category (generation persona)."
          }
        },
        "required": [
          "query"
        ],
        "title": "QueryRequest",
        "type": "object"
      },
      "QueryResponse": {
        "properties": {
          "acf": {
            "$ref": "#/components/schemas/ACFSignal",
            "description": "ADZA Confidence Framework (Path B): band, score 0\u2013100, and explanation from cited evidence. Surfaced on every response."
          },
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "artifacts": {
            "description": "Downloadable exports (CSV/chart/DOCX/PDF). Populated on Agribusinesses and Integrated plans when the query requests an export and builders succeed; otherwise empty. Signed URL TTL defaults to 86400s \u2014 refresh via GET /artifacts/{artifact_id}/url.",
            "items": {
              "$ref": "#/components/schemas/ArtifactItem"
            },
            "title": "Artifacts",
            "type": "array"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationItem"
            },
            "title": "Citations",
            "type": "array"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "langfuse_trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Langfuse trace id when tracing is enabled (for feedback / debugging)",
            "title": "Langfuse Trace Id"
          },
          "session_found": {
            "default": false,
            "description": "True when a prior server-side session blob was loaded for this request (Redis / in-memory). False for new sessions, expired/missing ids, or when chat_history is supplied (server session is not read).",
            "title": "Session Found",
            "type": "boolean"
          },
          "session_id": {
            "description": "Pass on the next request for chat continuity",
            "title": "Session Id",
            "type": "string"
          },
          "session_ttl_seconds": {
            "description": "Configured server session TTL (RAG_SESSION_TTL_SECONDS, default 604800).",
            "title": "Session Ttl Seconds",
            "type": "integer"
          },
          "source_basis": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ontology routing basis when ADZA_ONTOLOGY_ROUTING=1: structured, documents_only, web_only, or none. Omitted / null when routing is off.",
            "title": "Source Basis"
          },
          "trace": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace"
          },
          "usage": {
            "$ref": "#/components/schemas/UsageStats"
          }
        },
        "required": [
          "answer",
          "acf",
          "session_id"
        ],
        "title": "QueryResponse",
        "type": "object"
      },
      "TraceFeedbackRequest": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "score": {
            "description": "1.0 = thumbs up, 0.0 = thumbs down",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          },
          "trace_id": {
            "minLength": 1,
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "score"
        ],
        "title": "TraceFeedbackRequest",
        "type": "object"
      },
      "UsageStats": {
        "properties": {
          "input_tokens": {
            "default": 0,
            "title": "Input Tokens",
            "type": "integer"
          },
          "output_tokens": {
            "default": 0,
            "title": "Output Tokens",
            "type": "integer"
          },
          "total_tokens": {
            "default": 0,
            "title": "Total Tokens",
            "type": "integer"
          }
        },
        "title": "UsageStats",
        "type": "object"
      },
      "UserProfile": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "Government",
              "NGOs",
              "Agribusinesses",
              "Farmers"
            ],
            "title": "Category",
            "type": "string"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "plan_type": {
            "enum": [
              "Free",
              "Farmers",
              "Government",
              "NGOs",
              "Agribusinesses",
              "Integrated"
            ],
            "title": "Plan Type",
            "type": "string"
          }
        },
        "required": [
          "plan_type",
          "category"
        ],
        "title": "UserProfile",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Ask ADZA RAG API for enterprise partners. Authenticate every request with X-API-Key or Authorization: Bearer.",
    "title": "Ask ADZA Enterprise API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root"
      }
    },
    "/artifacts/{artifact_id}/url": {
      "get": {
        "description": "Re-sign a download URL for an existing export artifact.\n\nSigned URLs expire after ``RAG_ARTIFACT_SIGNED_URL_TTL_SECONDS`` (default **86400**).\nPass the ``id`` and ``filename`` from the original ``artifacts[]`` item.",
        "operationId": "get_artifact_url_artifacts__artifact_id__url_get",
        "parameters": [
          {
            "in": "path",
            "name": "artifact_id",
            "required": true,
            "schema": {
              "title": "Artifact Id",
              "type": "string"
            }
          },
          {
            "description": "Original artifact filename from the query response",
            "in": "query",
            "name": "filename",
            "required": true,
            "schema": {
              "description": "Original artifact filename from the query response",
              "minLength": 1,
              "title": "Filename",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactUrlResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Artifact Url"
      }
    },
    "/feedback": {
      "post": {
        "description": "Record user feedback (thumbs up/down) on a Langfuse trace.",
        "operationId": "trace_feedback_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TraceFeedbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Trace Feedback"
      }
    },
    "/health": {
      "get": {
        "description": "Liveness probe for GCE / orchestrators. Always returns quickly.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
