    "/v1/sessions/{plan_type_slug}": {
      "post": {
        "description": "Create a session scoped to a specific plan type.\n\nThe plan_type is inferred from the URL slug (e.g. /v1/sessions/farmers).\nCategory defaults to the natural category for the plan; can be overridden\nby passing ?category=... as a query parameter in future.",
        "operationId": "v1_create_plan_session_v1_sessions__plan_type_slug__post",
        "parameters": [
          {
            "in": "path",
            "name": "plan_type_slug",
            "required": true,
            "schema": {
              "title": "Plan Type Slug",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreateResponse"
                }
              }
            },
