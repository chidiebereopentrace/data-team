{
  "components": {
    "schemas": {
      "ChatMessage": {
        "properties": {
          "content": {
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "description": "user or assistant",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage",
        "type": "object"
      },
      "ChatRequest": {
        "additionalProperties": false,
        "properties": {
          "chat_history": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ChatMessage"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Prior turns for this request (canonical).",
            "title": "Chat History"
          },
          "conversation_history": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ChatMessage"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Deprecated alias for chat_history.",
            "title": "Conversation History"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "User message (alias for query)",
            "title": "Message"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "User message (alias for message)",
            "title": "Query"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional product user id for Langfuse analytics (client-supplied until auth).",
            "title": "User Id"
          },
          "user_profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserProfile"
              },
              {
                "type": "null"
              }
            ],
            "description": "User profile: country, plan_type, category."
          }
        },
        "title": "ChatRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SessionCreateRequest": {
        "properties": {
          "category": {
            "enum": [
              "Government",
              "NGOs",
              "Agribusinesses",
              "Farmers"
            ],
            "title": "Category",
            "type": "string"
          }
        },
        "required": [
          "category"
        ],
        "title": "SessionCreateRequest",
        "type": "object"
      },
      "SessionCreateResponse": {
        "properties": {
          "category": {
            "enum": [
              "Government",
              "NGOs",
              "Agribusinesses",
              "Farmers"
            ],
            "title": "Category",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "created_at",
          "category"
        ],
        "title": "SessionCreateResponse",
        "type": "object"
      },
      "SessionStatusResponse": {
        "description": "Response for GET /v1/sessions/{session_id}.",
        "properties": {
          "alive": {
            "title": "Alive",
            "type": "boolean"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "has_summary": {
            "default": false,
            "title": "Has Summary",
            "type": "boolean"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "turn_count": {
            "default": 0,
            "title": "Turn Count",
            "type": "integer"
          }
        },
        "required": [
          "session_id",
          "alive"
        ],
        "title": "SessionStatusResponse",
        "type": "object"
      },
      "UserProfile": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "Government",
              "NGOs",
              "Agribusinesses",
              "Farmers"
            ],
            "title": "Category",
            "type": "string"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "plan_type": {
            "enum": [
              "Free",
              "Farmers",
              "Government",
              "NGOs",
              "Agribusinesses",
              "Integrated"
            ],
            "title": "Plan Type",
            "type": "string"
          }
        },
        "required": [
          "plan_type",
          "category"
        ],
        "title": "UserProfile",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Public v1 API for Ask ADZA enterprise partners. Authenticate with X-API-Key or Authorization: Bearer when enterprise auth is enabled.",
    "title": "Ask ADZA Enterprise Chatbot API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
