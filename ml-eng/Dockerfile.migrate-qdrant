# One-shot Qdrant Cloud -> self-managed Qdrant migration job (ML-073 cutover).
# See deploy/RAILWAY_QDRANT_MIGRATION.md for the Railway service setup and env vars.
#
# Build from ml-eng/ (Railway root directory should be ml-eng):
#   docker build -f Dockerfile.migrate-qdrant -t opentrace-migrate-qdrant:latest .
#
# Required env vars:
#   QDRANT_OLD_URL, QDRANT_OLD_API_KEY   (source: Qdrant Cloud)
#   QDRANT_URL, QDRANT_API_KEY           (target: self-managed Qdrant, e.g. qdrant.railway.internal:6333)
# Optional:
#   MIGRATE_COLLECTIONS=news_data,policies   (default: all collections on the source)
#   MIGRATE_VERIFY_ONLY=1                    (compare point counts only, no transfer)

FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir "qdrant-client>=1.9.0"

COPY ml/rag/ops/migrate_qdrant.py ./ml/rag/ops/migrate_qdrant.py
COPY ml/rag/ops/__init__.py ./ml/rag/ops/__init__.py

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "ml.rag.ops.migrate_qdrant"]
