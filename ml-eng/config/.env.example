# ML/AI-eng env template (copy to your own env file; never commit secrets)

# --- BigQuery (used by RAG BQ retriever + some ML feature pipelines) ---
BQ_PROJECT=opentrace-prod-5ga4
# RAG NL-to-SQL queries staging_dev (silver) only.
BQ_DATASET_SILVER=staging_dev
# Bronze/raw remains available for data-eng tooling; RAG does not query it.
BQ_DATASET_BRONZE=raw_dev

# --- LLM backend (pick ONE path) ---
#
# Production (Railway): OpenRouter — set all three; do NOT set HF router for generation.
# RAG_LLM_BASE_URL=https://openrouter.ai/api/v1
# RAG_LLM_API_KEY=<OPENROUTER_API_KEY>
# RAG_LLM_MODEL_ID=openrouter/owl-alpha
# RAG_EMBEDDINGS_MODE=fastembed   # Railway / production (ONNX in container via fastembed)
# RAG_EMBEDDINGS_MODE=local       # dev with sentence-transformers + torch
# FASTEMBED_CACHE_PATH=/app/models/fastembed   # set in Dockerfile.railway
# HF_API_TOKEN=                   # optional; not used for embeddings (OpenRouter handles LLM)
# OPENROUTER_HTTP_REFERER=https://opentrace.africa
# OPENROUTER_APP_TITLE=Ask ADZA
# RAG_OPENROUTER_SESSION_ID=on   # bundle LLM calls per RAG run in OpenRouter Logs (default on for openrouter.ai)
#
# Local dev: LM Studio / vLLM (when set, skips HF router for generation).
RAG_LLM_BASE_URL=http://127.0.0.1:1234/v1
# RAG_LLM_API_KEY=
RAG_LLM_MODEL_ID=qwen/qwen3-30b-a3b-instruct-2507
RAG_SUMMARY_MODEL_ID=qwen/qwen3-30b-a3b-instruct-2507

# Per-plan LLM model routing (ML-041). All tiers default to the same Qwen3-30B-A3B chat model.
# Unset any var to use that shared default (or RAG_LLM_MODEL_ID when plan is unknown).
# RAG_LLM_MODEL_FREE=qwen/qwen3-30b-a3b-instruct-2507
# RAG_LLM_MODEL_FARMERS=qwen/qwen3-30b-a3b-instruct-2507
# RAG_LLM_MODEL_GOVERNMENT=qwen/qwen3-30b-a3b-instruct-2507
# RAG_LLM_MODEL_NGOS=qwen/qwen3-30b-a3b-instruct-2507
# RAG_LLM_MODEL_AGRIBUSINESSES=qwen/qwen3-30b-a3b-instruct-2507
# RAG_LLM_MODEL_INTEGRATED=qwen/qwen3-30b-a3b-instruct-2507
RAG_LLM_TIMEOUT_S=300
# Reranker
#
# RAG_RERANKER_MODE values:
#   cross_encoder  Production (Railway + local). Batch cross-encoder via fastembed
#                  ONNX (Railway slim image) or sentence-transformers (dev fallback).
#                  Model: BAAI/bge-reranker-base (multilingual, ~280 MB, baked in
#                  Dockerfile.railway). REQUIRED on Railway when using OpenRouter
#                  LLM — otherwise auto-promotion picks OpenRouter /rerank.
#   cohere         Optional. Cohere managed API. Requires COHERE_API_KEY.
#   openrouter     Optional. POST /api/v1/rerank via OpenRouter (RAG_LLM_API_KEY).
#   llm            Legacy per-chunk LLM scoring. Slow — A/B testing only.
#   off            Pass-through using the static source boost. Debug only.
#
# Back-compat: RAG_LLM_RERANK=on/off still works when RAG_RERANKER_MODE unset.
#
# Cohere (optional alternative):
COHERE_API_KEY=
# RAG_RERANKER_COHERE_API_KEY=   # alternative key var (takes precedence over COHERE_API_KEY)
# RAG_RERANKER_COHERE_MODEL=rerank-v3.5
#
# OpenRouter rerank (optional alternative; reuse RAG_LLM_API_KEY):
# RAG_RERANKER_MODE=openrouter
# RAG_RERANK_MODEL_ID=cohere/rerank-4-pro
# RAG_RERANK_TIMEOUT_S=30
# RAG_RERANK_MAX_DOC_CHARS=2000
#
# Cross-encoder (production default on Railway):
RAG_RERANKER_MODE=cross_encoder
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
# Optional override — code default is 24 in graph.py (_DEFAULT_RERANK_POOL_SIZE)
RAG_RERANK_POOL_SIZE=24
# RAG_RERANKER_TOP_K=0           # 0 = use the caller-supplied top_k (default 18)
# RAG_RERANKER_MAX_TEXT_CHARS=2000

# --- ACF (ADZA Confidence Framework) — Sprint 1, Week 2 ---
# Thresholds and copy are configurable; defaults are sensible.
# ACF_THRESHOLD_HIGH=0.75
# ACF_THRESHOLD_MEDIUM=0.45
# ACF_THRESHOLD_LOW=0.10
# ACF_NOTE_HIGH=This response is well-supported by multiple OpenTrace sources.
# ACF_NOTE_MEDIUM=This response is supported by limited OpenTrace sources. Some details may be incomplete.
# ACF_NOTE_LOW=Few relevant sources were found. Treat this response with caution.
# ACF_NOTE_NO_EVIDENCE=No OpenTrace sources matched this query. This is a data gap, not a low-confidence answer.

# --- Hugging Face (embeddings on Railway; optional LLM fallback if RAG_LLM_BASE_URL unset) ---
HF_API_TOKEN=
HF_HOME=data/local/models/chunking/huggingface
# Generator (OpenRouter production defaults — longer synthesis + more context)
RAG_GENERATE_MAX_TOKENS=2048
RAG_GENERATE_CONTEXT_MAX_CHARS=12000
RAG_GENERATE_CHUNK_MAX_CHARS=3000
RAG_GENERATE_TIMEOUT_S=300
# Generation temperature for the final advisory answer (higher = more natural, varied prose).
# Sprint 1 (Jul 2026): set to 0.7 for response variety across similar queries.
# The "no synthesis on gaps" test-1 concern is enforced by CODE guardrails, not
# temperature: empty context → `_no_data_fallback_message` (no LLM call);
# `RAG_ALLOW_UNGROUNDED` path is prompt-hardened; broken chunks are filtered out.
RAG_GENERATE_TEMPERATURE=0.7
# Citations block: referenced (default) = only sources cited inline as [Source N]; all = every packed source
# RAG_CITATIONS_MODE=referenced
# Legacy: append Sources markdown to answer text (default off; API clients use citations array)
# RAG_APPEND_SOURCES_TO_ANSWER=0

# Web fallback (off by default): shaped Wikipedia queries (opensearch + soft geo filter) when
# internal context is weak; Tavily tier-2 if wiki empty + TAVILY_API_KEY
# RAG_WEB_FALLBACK_ENABLED=0
# RAG_WEB_FALLBACK_MIN_CHUNKS=3
# Max Wikipedia page summaries/section extracts per fallback (default 2)
# RAG_WEB_WIKI_TOP_K=2
# RAG_WEB_TAVILY_TOP_K=2
# RAG_WEB_TOP_K=3
# RAG_WEB_TIMEOUT_S=8
# RAG_WEB_FALLBACK_MIN_RERANK_SCORE=-1
# Tavily guardrails: stay under the free-tier ~1k/day cap and don't retry on 429s.
# Set RAG_TAVILY_DAILY_LIMIT=0 as an operational kill-switch for Tavily.
# RAG_TAVILY_DAILY_LIMIT=900
# RAG_TAVILY_BACKOFF_S=2

# BQ NL-to-SQL: up to 10 queries (one LLM call per vector-matched table hint, sequential by default)
RAG_BQ_MAX_SQL_QUERIES=10
RAG_BQ_MAX_TABLES=6
RAG_BQ_NL2SQL_MODE=per_hint
RAG_BQ_NL2SQL_PARALLEL=off
RAG_BQ_SKIP_LIVE_SCHEMA=on
RAG_BQ_ROWS_PER_QUERY=10
RAG_BQ_NL2SQL_MAX_TOKENS=1024
RAG_BQ_NL2SQL_TIMEOUT_S=300
# LATENCY: soft per-call budget inside the parallel NL2SQL batch (distinct from the hard
# HTTP timeout above). One unusually slow reasoning-model call used to drag the whole
# batch/request down with it (measured: one 62s call blocked a 4-call batch that would
# otherwise finish in ~20s). After this budget, unfinished calls are abandoned and their
# table hint is simply skipped for this request -- see LATENCY_INVESTIGATION_2026-08-23.md
# "Fourth finding". Tune based on the timed_out_hints metric in Langfuse post-deploy.
RAG_BQ_NL2SQL_CALL_TIMEOUT_S=20
# Byte budgets for YAML reasoner / NL2SQL / BQ context (UTF-8)
RAG_BQ_REASONER_INDEX_MAX_BYTES=12000
RAG_BQ_HINT_MAX_BYTES=8000
RAG_BQ_CONTEXT_MAX_BYTES=6000
# Dedicated BQ models (chat stays on RAG_LLM_MODEL_ID / Qwen3-30B-A3B)
RAG_BQ_REASONER_MODEL_ID=deepseek/deepseek-v4-flash-0731
RAG_BQ_NL2SQL_MODEL_ID=deepseek/deepseek-v4-flash-0731
# Railway / OpenRouter: prefer RAG_BQ_NL2SQL_PARALLEL=on
# RAG_BQ_NL2SQL_PARALLEL_WORKERS=4

# --- Qdrant Cloud (vector store for RAG) ---
QDRANT_URL=https://...
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_TIMEOUT_S=30

# --- RAG ingestion from Google Drive (rebuild 4 Qdrant collections) ---
# OAuth client secret json file downloaded from Google Cloud Console (Desktop app).
GDRIVE_OAUTH_CLIENT_SECRET_JSON=
# Token cache (will be created/updated by ingestion CLI)
GDRIVE_TOKEN_PATH=
RAG_INGESTION_STAGING_ROOT=

# Google Drive folder IDs or folder share URLs (share with the logged-in OAuth user)
GDRIVE_FOLDER_RESEARCH_PAPERS_ID=
GDRIVE_FOLDER_OTHER_PAPERS_ID=
GDRIVE_FOLDER_NEWS_ID=
GDRIVE_FOLDER_OTA_INSIGHTS_ID=

# Qdrant collection per corpus (six first-class retrieve paths in graph.py)
QDRANT_COLLECTION_NEWS=news_data
QDRANT_COLLECTION_ACADEMIC_PAPERS=academic_papers
QDRANT_COLLECTION_POLICIES=policies
QDRANT_COLLECTION_PUBLIC_REPORTS=public_reports
QDRANT_COLLECTION_FORMATION=formation
QDRANT_COLLECTION_OTA_INSIGHTS=OTA_insights
# Optional legacy mixed research collection (off by default)
QDRANT_COLLECTION_RESEARCH_PAPERS=research_other_papers
# RAG_USE_LEGACY_RESEARCH_COLLECTION=off
# Legacy alias only (do not use as live default): news_public_reports

# Per-corpus dense vector size (must match embedding model output dim)
RAG_QDRANT_VECTOR_SIZE_NEWS=384
RAG_QDRANT_VECTOR_SIZE_RESEARCH=384
RAG_QDRANT_VECTOR_SIZE_OTA=384
# Fallback when a per-corpus var above is unset
RAG_QDRANT_VECTOR_SIZE=384

# Per-corpus embedding models (output dim must match vector size vars above)
RAG_EMBEDDING_MODEL_NEWS=intfloat/multilingual-e5-small
RAG_EMBEDDING_MODEL_RESEARCH=intfloat/multilingual-e5-small
RAG_EMBEDDING_MODEL_OTA=intfloat/multilingual-e5-small
RAG_EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small

# Chunking overrides (defaults in chunking_config.py)
# RAG_CHUNK_TARGET_TOKENS_NEWS=500
# RAG_CHUNK_OVERLAP_PCT_NEWS=0.15
# RAG_CHUNK_TARGET_TOKENS_RESEARCH=700
# RAG_CHUNK_OVERLAP_PCT_RESEARCH=0.10
# RAG_CHUNK_MAX_CHUNKS_RESEARCH=400
# RAG_CHUNK_TARGET_TOKENS_OTA=800

# Per-collection retrieval vector modes (graph + eval use profile defaults)
# news_data: dense + sparse | research: single dense + sparse | OTA: triple + sparse
RAG_QDRANT_NEWS_VECTOR_SEARCH_MODE=dense_named
RAG_QDRANT_RESEARCH_VECTOR_SEARCH_MODE=dense_named
RAG_QDRANT_OTA_VECTOR_SEARCH_MODE=ota_triple
RAG_QDRANT_OTA_QUERY_USING=merge
RAG_QDRANT_VECTOR_SEARCH_MODE=dense_named

# Dense embeddings: in-container only — local (torch dev) | fastembed (Railway ONNX)
# RAG_EMBEDDINGS_MODE=fastembed

# Sparse BM25 + hybrid dense/sparse retrieval (requires fastembed)
RAG_SPARSE_EMBEDDINGS=on
RAG_QDRANT_HYBRID_SEARCH=on
RAG_SPARSE_MODEL=Qdrant/bm25
# Wider prefetch + tight RRF cap improves recall without inflating candidates.
RAG_HYBRID_DENSE_PREFETCH=40
RAG_HYBRID_SPARSE_PREFETCH=40
RAG_HYBRID_FUSION_LIMIT=20

# Meta / identity query handling (who are you, what do you do, etc.)
# hybrid (default): static answers for canonical questions + LLM persona for variants
# static: always canned text, no LLM call on meta path
# llm: always use persona prompt (no static copy)
# RAG_META_RESPONSES=hybrid

# Streamlit pipeline inspector (QA UI — local or Railway second service)
# RAG_STREAMLIT_DEBUG_DEFAULT=1          # show inspector panel after each turn (default on)
# RAG_SHOW_SQL_DEBUG=1                 # show generated SQL in inspector (internal QA)
# RAG_API_BASE_URL=https://your-railway-api.up.railway.app   # HTTP mode in Streamlit sidebar

# Product knowledge JSON for OpenTrace/Ask ADZA questions (aim, OFIA, ACF, partnerships, etc.)
# Default: ml/rag/chatbot/data/opentrace_product.json (committed; baked into Railway image via COPY ml/)
# RAG_PRODUCT_KB_PATH=/app/ml/rag/chatbot/data/opentrace_product.json

# --- Redis for durable chat sessions + shared caches (required for horizontal scaling) ---
# When set, the RAG API (and any workers) share session memory and expensive caches
# (BQ schema, bronze catalog) across processes/replicas. Without it, sessions are
# in-process only (fine for single-worker dev or Streamlit; lost on restart/scale).
# Use Google Memorystore, Upstash, or a sidecar Redis for GCE/Cloud Run.
# Railway API: same environment as Redis — private URL only, e.g.:
#   RAG_REDIS_URL=redis://redis.railway.internal:6379/0
#   # or RAG_REDIS_URL=${{Redis.REDIS_URL}}
# Do not use REDIS_PUBLIC_URL / *.proxy.rlwy.net for API↔Redis.
# Streamlit in a different Railway environment: leave RAG_REDIS_URL unset.
# RAG_REDIS_URL=redis://localhost:6379/0
# RAG_REDIS_URL=rediss://user:pass@host:6380/0   # TLS example
# RAG_SESSION_TTL_SECONDS=604800     # 7 days default for conversation memory
# RAG_CACHE_TTL_SECONDS=3600        # 1h for BQ schema / catalog L2 caches
# RAG_REDIS_CONNECT_TIMEOUT_S=2

# --- Langfuse (optional observability / tracing, SDK v3+) ---
# When set, the RAG pipeline emits unified traces: request root span, LangGraph nodes,
# and llm_chat_complete generations (model + token usage).
# Leave unset for HF Space / Railway deploys that do not need tracing.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # EU Cloud (recommended)
# LANGFUSE_HOST=http://localhost:3000            # legacy alias for LANGFUSE_BASE_URL
# LANGFUSE_TRACING_ENVIRONMENT=development       # optional tag: production|staging|development
# LANGFUSE_TRACING_RELEASE=git-sha-or-version    # optional; on Railway falls back to RAILWAY_GIT_COMMIT_SHA
# LANGFUSE_TRACING_SAMPLE_RATE=1.0               # optional: 0.0–1.0 for high-volume sampling
# Optional product analytics: pass user_id on POST /query and POST /v1/chat

# RAG chat memory (rolling summary + verbatim turns). See chat_memory.py and ARCHITECTURE.md
# RAG_CHAT_VERBATIM_TURNS=5
# RAG_CHAT_HISTORY_MAX_CHARS=4000
# RAG_SUMMARY_MAX_CHARS=2000
# RAG_SUMMARY_MODEL_ID=qwen/qwen3-30b-a3b-instruct-2507   # already set above

# RAG retrieval / generation (optional)
# RAG_CORPUS_ROUTER=on            # heuristic gate/boost over six collections (default on; off = always all six)
# RAG_NEWS_DOMAIN_FILTER=on       # news domains MatchText filter (default on; set off to disable)
# RAG_NEWS_GEO_FALLBACK=on        # widen/drop geo when empty (default on; off for strict country QA)
# RAG_NEWS_TIME_FALLBACK=on
# RAG_RESEARCH_GEO_FALLBACK=on
# RAG_RESEARCH_TIME_FALLBACK=on
# RAG_ALLOW_UNGROUNDED=on         # LLM answers when retrieval is empty (default off)
# Sprint 1 (Jul 2026) source-purity + thin-context guards:
# RAG_DROP_GEO_CONFLICTING_CONTEXT=on   # drop chunks whose geo metadata names other
#                                       # countries than the query (default on). Set to
#                                       # off to keep all chunks regardless of geography.
# RAG_MIN_USABLE_CONTEXT=0              # min usable chunks required before calling the LLM;
#                                       # at/below this count return the structured gap
#                                       # response instead of padding thin context (default 0 = off).


# Research PDF preprocess (Unstructured + section filtering)
# RAG_USE_UNSTRUCTURED=1
# RAG_UNSTRUCTURED_STRATEGY=fast
# RAG_UNSTRUCTURED_LANGUAGES=eng,fra
# RAG_EXCLUDE_BOILERPLATE_CHUNKS=on
# RAG_RESEARCH_EXCLUDE_ROLES=acknowledgements,references,boilerplate,appendix
# Optional sidecar bibliographic metadata for research PDFs:
#   {pdf}.meta.json  or  research_bibliography.json  (keys: PDF filename or stem)
# Fields: article_title, authors, publication_year, journal, doi, volume, issue, pages

# Export artifacts (Agribusinesses / Integrated)
# Priority: S3 (Railway neat-icebox AWS_*) → GCS → local file://
# AWS_S3_BUCKET_NAME=          # from Railway neat-icebox.BUCKET
# AWS_ENDPOINT_URL=            # from neat-icebox.ENDPOINT
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# RAG_ARTIFACT_S3_PREFIX=rag-exports
# RAG_ARTIFACT_GCS_BUCKET=your-bucket
# RAG_ARTIFACT_GCS_PREFIX=rag-exports
# RAG_ARTIFACT_SIGNED_URL_TTL_SECONDS=86400
# RAG_ARTIFACT_MAX_BYTES=10485760
# RAG_ARTIFACT_LOCAL_DIR=   # dev fallback when S3/GCS unset (file:// URLs)

# Web data mining
TAVILY_API_KEY=
OPENAI_API_KEY=

# Auth: use gcloud auth application-default login, or set the path below (relative to ml-eng/).
# Railway/production: use GOOGLE_APPLICATION_CREDENTIALS_BASE64 instead of a file path.
GOOGLE_APPLICATION_CREDENTIALS=config/keys/opentrace-bq-key.json
