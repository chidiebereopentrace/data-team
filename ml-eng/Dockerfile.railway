# Railway-optimized RAG API image
# Ultra-light build: NO torch, transformers, or sentence-transformers
# Embeddings are pre-computed locally, API only does retrieval + generation
#
# Build from data-team/ml-eng directory:
#   docker build -f Dockerfile.railway -t opentrace-rag-railway:latest .

FROM python:3.11-slim

# Install minimal system dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and install dependencies (Railway-optimized - no ML libs)
COPY requirements.railway.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY ml ./ml
# Note: config/ is not copied - Railway uses environment variables only

# Set Python path and unbuffer output for Railway logs
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Health check for Railway
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT:-7860}/health || exit 1

# Railway uses PORT environment variable
ENV PORT=7860
EXPOSE $PORT

# Startup with GCP credential handling
CMD ["sh", "-c", "if [ -n \"$GOOGLE_APPLICATION_CREDENTIALS_BASE64\" ]; then echo \"$GOOGLE_APPLICATION_CREDENTIALS_BASE64\" | base64 -d > /tmp/gcp-sa-key.json && export GOOGLE_APPLICATION_CREDENTIALS=/tmp/gcp-sa-key.json && echo 'GCP credentials configured'; fi && echo '=== Starting RAG API ===' && uvicorn ml.rag.api:app --host 0.0.0.0 --port ${PORT:-7860}"]
